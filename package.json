{
  "name": "playwright-layout-inspector",
  "version": "1.0.0",
  "description": "Comprehensive layout & UX measurement tooling for Playwright to audit DOM overflow, visual stability, layout shifts, mobile fit, and touch target ergonomics.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.mjs",
      "require": "./dist/matchers.cjs"
    }
  },
  "bin": {
    "playwright-layout-inspector": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo"
  },
  "keywords": [
    "playwright",
    "layout",
    "ux",
    "audit",
    "viewport",
    "overflow",
    "layout-shift",
    "cls",
    "touch-targets",
    "mobile-testing",
    "visual-testing",
    "responsiveness"
  ],
  "author": "Steven T. Pelech",
  "license": "MIT",
  "peerDependencies": {
    "@playwright/test": "^1.30.0 || ^1.40.0 || ^1.50.0 || ^1.60.0",
    "playwright": "^1.30.0 || ^1.40.0 || ^1.50.0 || ^1.60.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "playwright": "^1.50.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
